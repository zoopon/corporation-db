# Environment configuration example
# Copy this file to .env and modify as needed

# Host port mapping (default: 8080, production: 80)
# This maps the host port to the container's internal port 8080
PORT=8080

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=corporation_db

# Application environment
GO_ENV=development

# For production deployment, uncomment and modify:
# PORT=80  # This will map host port 80 to container port 8080
# GO_ENV=production
